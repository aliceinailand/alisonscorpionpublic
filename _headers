# Long-lived static Cache-Control (1 year + immutable).
# Pin/version in the URL (path or ?v=) when content changes; purge CF manually if needed.
# Edge Cache Rules: tools/apply_cf_static_cache_rules.py (TTL 31536000)

/safety/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/safety/hosts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/website/staging/brand/*
  Cache-Control: public, max-age=31536000, immutable

# Shell CSS/JS — cache-busted via ?v= on <script>/<link>
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/desktop/css/*
  Cache-Control: public, max-age=31536000, immutable

/desktop/js/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/favicon-16x16.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-32x32.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/scorpion-icon-512.png
  Cache-Control: public, max-age=31536000, immutable
